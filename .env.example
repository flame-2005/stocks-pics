# Copy to .env and fill in. Never commit .env.

# Telegram: create a bot with @BotFather, then message it once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Position sizing (INR). Paper-trade first; these only affect the quantity printed in the message.
CAPITAL=100000
RISK_PCT=1.0            # % of CAPITAL risked per trade (entry to stop loss)
MAX_LEVERAGE=4          # notional cap = CAPITAL * MAX_LEVERAGE (intraday MIS leverage)
DAILY_LOSS_CAP_PCT=1.5  # printed in every message as the discipline rule

# Where SQLite + parquet cache live. Keep OUT of OneDrive (SQLite + sync = corruption).
# Defaults to %LOCALAPPDATA%\intraday-picks when empty.
DATA_DIR=

# Dates to force "no trade" (comma separated YYYY-MM-DD): budget day, RBI policy, election results...
NO_TRADE_DATES=

# orb = side decided at 09:34 from the opening candles (default); evening = decided the night before
DECISION_MODE=orb

# Optional: log level DEBUG|INFO|WARNING
LOG_LEVEL=INFO

# Supabase project used by the Next.js dashboard. The Python side writes with the service-role
# key (never ship this key to the browser); the dashboard reads with the anon key + user login.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_DAYS=10
