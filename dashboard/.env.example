# Supabase project (Project Settings -> API). The anon key is safe in the browser; RLS limits it
# to SELECT for signed-in users. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used for password-reset redirects when the request has no Origin header (optional).
NEXT_PUBLIC_SITE_URL=
